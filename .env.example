# Copy to .env and adjust. Every variable is optional.

# HTTPS server for the phone (the camera needs a secure context)
HTTPS_PORT=8443
HTTPS_HOST=0.0.0.0

# Plain HTTP server for this computer (CSV downloads). Keep it on 127.0.0.1.
HTTP_PORT=8787
HTTP_HOST=127.0.0.1

# Scanned cards, caches and the self-signed certificate
DATA_DIR=./data

# Use your own certificate instead of the generated self-signed one
# TLS_CERT=/path/to/cert.pem
# TLS_KEY=/path/to/key.pem

# Extra names/IPs for the self-signed certificate (comma separated), e.g. your LAN IP with Docker.
# Delete DATA_DIR/cert.pem and key.pem after changing it.
# CERT_HOSTS=192.168.1.20,scanner.local

# Keep each recognised crop in DATA_DIR/reads (and camera diagnostics) to debug the OCR
DEBUG_CAPTURE=false
DEBUG_CAPTURE_KEEP=200

# Threads used by the OCR model
OCR_THREADS=2

CARDCLUSTER_URL=https://cardcluster.com
